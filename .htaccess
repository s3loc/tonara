# Apache sunucularda güvenlik başlıkları (Netlify / Cloudflare Pages için _headers dosyası kullanılır)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-vYBUQa0TI0Z+McwTC375RV2I9jc2EhNIojiL3Fs9B8Y=' 'sha256-SrZ5wKYkO4CQaq1473tMd/eXfzR8I7GuNyiP2lB1KPg=' 'sha256-UT0EOgheDNHHRtjjiXXkafcg+gbiHghJ3FrerM7truw=' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gstatic.com/recaptcha/; font-src 'self'; connect-src 'self' https://formspree.io; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; media-src 'self'; object-src 'none'; base-uri 'self'; form-action https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
Options -Indexes
<FilesMatch "\.(zip|md)$">
  Require all denied
</FilesMatch>

# Uzantısız adresler: /pilot → pilot.html (Cloudflare'de bunu auto-trailing-slash kendisi yapar)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_kaynak(/|$) - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]
</IfModule>
ErrorDocument 404 /404.html
